# Only read by Node. Never prefix private variables with VITE_.
# In Vercel these values go in Environment Variables, not in an uploaded .env file.
# SUPABASE_* can be omitted in Vercel if the corresponding VITE_SUPABASE_* values are set.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Use the dedicated hexfortia_server role, TLS and a verified certificate.
DATABASE_URL=postgresql://hexfortia_server:YOUR_PASSWORD@db.your-project.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=server/certificates/prod-ca-2021.crt
APP_ORIGIN=http://localhost:5173
# The port and host below are only used by the local persistent server.
API_HOST=127.0.0.1
API_PORT=3001
