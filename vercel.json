{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm test:vercel && pnpm build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/admin", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "regions": ["dub1"],
  "functions": {
    "api/*.ts": {
      "includeFiles": "server/certificates/*.crt",
      "maxDuration": 30
    }
  }
}
